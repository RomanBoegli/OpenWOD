# Production and Portainer: replace with your own published image or, better, its immutable digest.
APP_IMAGE=ghcr.io/YOUR_GITHUB_OWNER/openwod:v1.1.2
HTTP_PORT=8080
# The SQLite file inside the container. Keep it under /data, the named volume, or it is lost with the container.
DATABASE_PATH=/data/app.sqlite
# fatal, error, warn, info, debug, trace or silent.
LOG_LEVEL=info
# false, true, or a comma-separated list of reverse-proxy addresses whose X-Forwarded-* headers are trusted.
TRUST_PROXY=false
# HTTPS served by the container itself: both the key and the certificate, each as a file path inside the container (under /data) or as the PEM text with newlines written as \n. Leave empty behind a reverse proxy.
HTTPS_KEY=
HTTPS_CERT=
