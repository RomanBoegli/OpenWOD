{
  "name": "openwod",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "homepage": "https://github.com/RomanBoegli/OpenWOD",
  "repository": {
    "type": "git",
    "url": "https://github.com/RomanBoegli/OpenWOD.git"
  },
  "description": "OpenWOD: a workout player for training at home, solo or in pairs. Not born. Made.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:server": "node scripts/dev.mjs server",
    "dev:full": "node scripts/dev.mjs full",
    "build": "npm run typecheck && vite build && node scripts/check-production.mjs && esbuild apps/server/src/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server/index.js",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config tests/vitest.config.ts",
    "test:watch": "vitest --config tests/vitest.config.ts",
    "test:e2e": "playwright test --config tests/playwright.config.ts",
    "test:production": "playwright test --config tests/playwright.production.config.ts",
    "schemas:generate": "tsx scripts/generate-schemas.ts",
    "schemas:check": "tsx scripts/generate-schemas.ts --check",
    "workouts:bundle": "tsx scripts/bundle-workouts.ts",
    "workouts:check": "tsx scripts/bundle-workouts.ts --check",
    "check": "npm run typecheck && npm run schemas:check && npm run workouts:check && npm test",
    "browsers:install": "node scripts/install-browsers.mjs",
    "cues:generate": "tsx scripts/generate-cues.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "node": "24.22.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@fastify/static": "10.1.7",
    "@sinclair/typebox": "0.34.52",
    "ajv": "8.20.0",
    "fastify": "5.12.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "yaml": "2.9.1"
  }
}
