                            "pattern": "^(?:\\d+ms|\\d+:\\d{2}(?::\\d{2})?|(?=.)(?:\\d+h)?(?:\\d+m)?(?:\\d+(?:\\.\\d+)?s)?)$",
                            "type": "string"
