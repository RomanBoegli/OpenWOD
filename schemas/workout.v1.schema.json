{
  "$id": "Workout",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "description": {
      "maxLength": 2000,
      "type": "string"
    },
    "equipment": {
      "items": {
        "maxLength": 80,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 30,
      "type": "array"
    },
    "id": {
      "maxLength": 120,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_.:-]+$",
      "type": "string"
    },
    "participants": {
      "anyOf": [
        {
          "const": 1,
          "type": "number"
        },
        {
          "const": 2,
          "type": "number"
        }
      ]
    },
    "prepMs": {
      "maximum": 60000,
      "minimum": 0,
      "type": "integer"
    },
    "revision": {
      "minimum": 1,
      "type": "integer"
    },
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "sections": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "body": {
            "$id": "WorkoutNode",
            "anyOf": [
              {
                "additionalProperties": false,
                "properties": {
                  "assignments": {
                    "additionalProperties": false,
                    "properties": {
                      "A": {
                        "additionalProperties": false,
                        "properties": {
                          "load": {
                            "additionalProperties": false,
                            "properties": {
                              "unit": {
                                "anyOf": [
                                  {
                                    "const": "kg",
                                    "type": "string"
                                  },
                                  {
                                    "const": "lb",
                                    "type": "string"
                                  }
                                ]
                              },
                              "value": {
                                "maximum": 10000,
                                "minimum": 0,
                                "type": "number"
                              }
                            },
                            "required": [
                              "value",
                              "unit"
                            ],
                            "type": "object"
                          },
                          "name": {
                            "maxLength": 160,
                            "minLength": 1,
                            "type": "string"
                          },
                          "notes": {
                            "maxLength": 500,
                            "type": "string"
                          },
                          "reps": {
                            "maximum": 100000,
                            "minimum": 1,
                            "type": "integer"
                          },
                          "shortName": {
                            "maxLength": 160,
                            "minLength": 1,
                            "type": "string"
                          },
                          "spokenName": {
                            "maxLength": 160,
                            "minLength": 1,
                            "type": "string"
                          }
                        },
                        "required": [
                          "name"
                        ],
                        "type": "object"
                      },
                      "B": {
                        "additionalProperties": false,
                        "properties": {
                          "load": {
                            "additionalProperties": false,
                            "properties": {
                              "unit": {
                                "anyOf": [
                                  {
                                    "const": "kg",
                                    "type": "string"
                                  },
                                  {
                                    "const": "lb",
                                    "type": "string"
                                  }
                                ]
                              },
                              "value": {
                                "maximum": 10000,
                                "minimum": 0,
                                "type": "number"
                              }
                            },
                            "required": [
                              "value",
                              "unit"
                            ],
                            "type": "object"
                          },
                          "name": {
                            "maxLength": 160,
                            "minLength": 1,
                            "type": "string"
                          },
                          "notes": {
                            "maxLength": 500,
                            "type": "string"
                          },
                          "reps": {
                            "maximum": 100000,
                            "minimum": 1,
                            "type": "integer"
                          },
                          "shortName": {
                            "maxLength": 160,
                            "minLength": 1,
                            "type": "string"
                          },
                          "spokenName": {
                            "maxLength": 160,
                            "minLength": 1,
                            "type": "string"
                          }
                        },
                        "required": [
                          "name"
                        ],
                        "type": "object"
                      }
                    },
                    "required": [
                      "A"
                    ],
                    "type": "object"
                  },
                  "durationMs": {
                    "maximum": 86400000,
                    "minimum": 1,
                    "type": "integer"
                  },
                  "id": {
                    "maxLength": 120,
                    "minLength": 1,
                    "pattern": "^[a-zA-Z0-9_.:-]+$",
                    "type": "string"
                  },
                  "type": {
                    "const": "timed",
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "type",
                  "durationMs",
                  "assignments"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "durationMs": {
                    "maximum": 86400000,
                    "minimum": 1,
                    "type": "integer"
                  },
                  "id": {
                    "maxLength": 120,
                    "minLength": 1,
                    "pattern": "^[a-zA-Z0-9_.:-]+$",
                    "type": "string"
                  },
                  "kind": {
                    "anyOf": [
                      {
                        "const": "transition",
                        "type": "string"
                      },
                      {
                        "const": "roundRest",
                        "type": "string"
                      },
                      {
                        "const": "blockRest",
                        "type": "string"
                      }
                    ]
                  },
                  "type": {
                    "const": "rest",
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "type",
                  "durationMs"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "betweenChildrenRestMs": {
                    "maximum": 86400000,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "children": {
                    "items": {
                      "$ref": "WorkoutNode"
                    },
                    "maxItems": 1000,
                    "minItems": 1,
                    "type": "array"
                  },
                  "id": {
                    "maxLength": 120,
                    "minLength": 1,
                    "pattern": "^[a-zA-Z0-9_.:-]+$",
                    "type": "string"
                  },
                  "trailingRestMs": {
                    "maximum": 86400000,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "type": {
                    "const": "sequence",
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "type",
                  "children"
                ],
                "type": "object"
              },
              {
                "additionalProperties": false,
                "properties": {
                  "assignmentPolicy": {
                    "anyOf": [
                      {
                        "const": "fixed",
                        "type": "string"
                      },
                      {
                        "const": "alternate",
                        "type": "string"
                      }
                    ]
                  },
                  "betweenIterationsRestMs": {
                    "maximum": 86400000,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "body": {
                    "$ref": "WorkoutNode"
                  },
                  "count": {
                    "maximum": 999,
                    "minimum": 1,
                    "type": "integer"
                  },
                  "id": {
                    "maxLength": 120,
                    "minLength": 1,
                    "pattern": "^[a-zA-Z0-9_.:-]+$",
                    "type": "string"
                  },
                  "type": {
                    "const": "repeat",
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "type",
                  "count",
                  "body"
                ],
                "type": "object"
              }
            ]
          },
          "format": {
            "const": "timedCircuit",
            "type": "string"
          },
          "id": {
            "maxLength": 120,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_.:-]+$",
            "type": "string"
          },
          "title": {
            "maxLength": 160,
            "minLength": 1,
            "type": "string"
          },
          "transitionAfter": {
            "anyOf": [
              {
                "const": "manualReady",
                "type": "string"
              },
              {
                "const": "automatic",
                "type": "string"
              }
            ]
          }
        },
        "required": [
          "id",
          "title",
          "format",
          "transitionAfter",
          "body"
        ],
        "type": "object"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array"
    },
    "title": {
      "maxLength": 160,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "revision",
    "title",
    "equipment",
    "participants",
    "prepMs",
    "sections"
  ],
  "type": "object"
}
